# Optional. By default the app calls /api/users, /api/products and /api/orders,
# which the Vite dev server proxies to the services (see vite.config.ts).

# Absolute base URLs instead (requires CORS on the services):
# VITE_USERS_URL=http://localhost:4001
# VITE_PRODUCTS_URL=http://localhost:4002
# VITE_ORDERS_URL=http://localhost:4000

# Used to format product prices (orders carry their own currency).
VITE_CURRENCY=NGN

# Dev proxy targets, if your services run elsewhere.
# USERS_PROXY_TARGET=http://localhost:4001
# PRODUCTS_PROXY_TARGET=http://localhost:4002
# ORDERS_PROXY_TARGET=http://localhost:4000
