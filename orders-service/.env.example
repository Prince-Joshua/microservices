PORT=4000
POSTGRES_URL=postgresql://orders:orders@localhost:5432/orders
# Must match the users service: it signs the JWTs, this service verifies them.
JWT_SECRET=change-me-too
# Shared secret sent to the other services and required on /internal routes.
INTERNAL_API_TOKEN=change-me
USERS_SERVICE_URL=http://localhost:4001
# Also used to ask "is this session still alive?" so a signed-out access token is
# refused before it expires. A revocation reaches this service within SESSION_CACHE_MS.
# SESSION_CACHE_MS=30000
# Admin tokens are re-checked this often, and refused if the users service can't be asked.
# ADMIN_SESSION_CACHE_MS=15000
PRODUCTS_SERVICE_URL=http://localhost:4002
PAYMENTS_SERVICE_URL=http://localhost:4003
HTTP_TIMEOUT_MS=3000

# Payments
PAYMENT_CURRENCY=NGN
# How long a customer has to pay before the order is cancelled and its
# stock released (30 minutes).
PAYMENT_TTL_MS=1800000

# Saga recovery worker
# How often it looks for stuck sagas (and unpaid orders past their deadline).
SAGA_RECOVERY_INTERVAL_MS=15000
# A running saga untouched this long is treated as abandoned and re-driven.
SAGA_STALE_MS=30000
# If a saga still can't finish after this long, it is rolled back.
SAGA_MAX_AGE_MS=600000
