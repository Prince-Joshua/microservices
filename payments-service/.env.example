PORT=4003
POSTGRES_URL=postgresql://payments:payments@localhost:5433/payments

# Shared secret that other services send in the x-internal-token header.
INTERNAL_API_TOKEN=change-me
ORDERS_SERVICE_URL=http://localhost:4000
HTTP_TIMEOUT_MS=8000

# Paystack: use an sk_test_... key until you go live. This service is the
# only one that ever sees it. It also verifies webhook signatures with it.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack sends the customer after checkout (your frontend page).
# It receives ?reference=...&trxref=...; call POST /orders/:id/verify-payment from there.
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# Background worker
WORKER_INTERVAL_MS=30000
# A pending payment is only re-checked with Paystack after this long
# (the webhook normally beats it).
WORKER_MIN_AGE_MS=60000
# A payment still unpaid after this long is marked FAILED.
PAYMENT_ABANDON_MS=86400000
