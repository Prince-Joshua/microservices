# Render gateway. ${...} placeholders are filled from environment variables when the
# container starts; nginx's own $variables are left alone.
#   USERS_HOSTPORT, PRODUCTS_HOSTPORT, ORDERS_HOSTPORT, PAYMENTS_HOSTPORT  (e.g. users:10000)

resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

# Behind Vercel and Render's own proxy, $remote_addr is a proxy, not the customer.
# Use the first address in X-Forwarded-For for rate limiting (best effort: a caller
# who talks to this gateway directly could forge it).
map $http_x_forwarded_for $client_ip {
  default                  $remote_addr;
  "~^\s*(?<first>[^,\s]+)" $first;
}

limit_req_zone $client_ip zone=auth:10m rate=10r/m;

log_format trace escape=json
  '{"ts":"$time_iso8601","level":"info","service":"gateway","requestId":"$request_id",'
  '"msg":"request","method":"$request_method","path":"$uri","status":$status,'
  '"sec":$request_time,"upstream":"$upstream_addr"}';

server {
  listen 10000;
  access_log /dev/stdout trace;

  client_max_body_size 1m;

  proxy_http_version 1.1;
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $client_ip;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # The gateway makes the id; the services echo it back in their responses.
  proxy_set_header X-Request-Id      $request_id;
  proxy_read_timeout 30s;

  # Render's health check.
  location = /health { access_log off; return 200 "ok"; }

  # Service-to-service routes are never reachable from outside.
  location ~ ^/(api/[^/]+/)?internal/ { return 404; }

  # Variables in proxy_pass make nginx re-resolve the private hostname every few
  # seconds, so redeployed services are found again. rewrite strips the /api/<name> prefix.
  location /api/users/auth/ {
    limit_req zone=auth burst=10 nodelay;
    set $up http://${USERS_HOSTPORT};
    rewrite ^/api/users/(.*)$ /$1 break;
    proxy_pass $up;
  }
  location /api/users/ {
    set $up http://${USERS_HOSTPORT};
    rewrite ^/api/users/(.*)$ /$1 break;
    proxy_pass $up;
  }
  location /api/products/ {
    set $up http://${PRODUCTS_HOSTPORT};
    rewrite ^/api/products/(.*)$ /$1 break;
    proxy_pass $up;
  }
  location /api/orders/ {
    set $up http://${ORDERS_HOSTPORT};
    rewrite ^/api/orders/(.*)$ /$1 break;
    proxy_pass $up;
  }

  # The ONLY payments-service route that is public. Body passes through untouched
  # so the service can verify Paystack's signature.
  location = /webhooks/paystack {
    set $up http://${PAYMENTS_HOSTPORT};
    proxy_pass $up;
  }

  location / { return 404; }
}
