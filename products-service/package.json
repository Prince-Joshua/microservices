{
  "name": "products-service",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch server.ts",
    "dev:catalog": "tsx watch servers/catalog.ts",
    "dev:inventory": "tsx watch servers/inventory.ts",
    "dev:reconciler": "tsx watch servers/reconciler.ts",
    "start": "node dist/server.js",
    "start:catalog": "node dist/servers/catalog.js",
    "start:inventory": "node dist/servers/inventory.js",
    "start:reconciler": "node dist/servers/reconciler.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run clean && tsc && node --test --experimental-test-module-mocks \"dist/test/*.test.js\"",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0"
  },
  "main": "dist/server.js",
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
