PORT=4002
MONGO_URL=mongodb://localhost:27018/products
# Must match the users service: it signs the JWTs, this service verifies them.
JWT_SECRET=change-me-too
# Shared secret: callers send it in x-internal-token, and this service
# sends it when it asks the Orders service about reservations.
INTERNAL_API_TOKEN=change-me
ORDERS_SERVICE_URL=http://localhost:4000
# Asked "is this session still alive?" so a signed-out access token is refused
# before it expires. Leave it out to skip the check (tokens then simply expire).
USERS_SERVICE_URL=http://localhost:4001
# How long an answer is remembered; a revocation reaches this service within it.
# SESSION_CACHE_MS=30000
# Admin tokens are re-checked this often, and refused if the users service can't be asked.
# ADMIN_SESSION_CACHE_MS=15000
HTTP_TIMEOUT_MS=3000
# Reconciler: how old a reservation must be before it is checked.
# Keep this well above your slowest order request.
RECONCILE_OLDER_THAN_MS=600000
RECONCILE_INTERVAL_MS=60000

# Only for `npm run seed`: the seed refuses non-local databases and production.
# Set to "true" ONLY for a throwaway remote database. Never applies in production.
# SEED_ALLOW_REMOTE=true
