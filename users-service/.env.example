PORT=4001
MONGO_URL=mongodb://localhost:27017/users
# Signs customer JWTs. The orders and products services verify them,
# so all three must use the same value.
JWT_SECRET=change-me-too
# Access tokens are short-lived; the refresh token keeps people signed in.
JWT_EXPIRES_IN=15m
# A refresh token not used for this many days stops working.
REFRESH_TOKEN_TTL_DAYS=30
# A session can't last longer than this, however often it refreshes.
REFRESH_MAX_SESSION_DAYS=90
# Shared secret that other services send in the x-internal-token header.
INTERNAL_API_TOKEN=change-me

# Rate limiting (login and refresh). The defaults suit most shops; every value is optional.
# How many reverse proxies sit in front of this service. It decides which address counts
# as the caller's. 1 = one proxy (Render's load balancer, or nginx). Use 2 when the web
# app reaches this service through Vercel's rewrite AND Render's load balancer.
# Too low: every visitor shares one address. Too high: callers can forge theirs.
TRUST_PROXY=1
# RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
# LOGIN_MAX_PER_IP=100               # login attempts per address per window
# LOGIN_FAILS_PER_ACCOUNT_IP=5       # wrong passwords for one account from one address
# LOGIN_FAILS_PER_ACCOUNT=20         # wrong passwords for one account from anywhere
# REFRESH_MAX_PER_IP=300
# REFRESH_FAILS_PER_IP=30            # refreshes with a token that doesn't work

# Only for `npm run create-admin`
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_NAME=Admin

# Only for `npm run seed`: the seed refuses non-local databases and production.
# Set to "true" ONLY for a throwaway remote database. Never applies in production.
# SEED_ALLOW_REMOTE=true
