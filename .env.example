# Used by docker-compose.prod.yml  ->  cp .env.example .env  and fill in.
# Generate secrets with:  openssl rand -hex 32

# Public address customers use (no trailing slash). Paystack redirects to
# ${PUBLIC_URL}/payment/callback, and its webhook must be https://<host>/webhooks/paystack
PUBLIC_URL=http://localhost

# Signs/verifies customer JWTs (users, orders, products share it)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
# Service-to-service token (all four)
INTERNAL_API_TOKEN=change-me-too

# Paystack (sk_test_... until you go live). Only payments-service sees it.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYMENT_CURRENCY=NGN

# Database passwords
ORDERS_DB_PASSWORD=change-me
PAYMENTS_DB_PASSWORD=change-me

# Copies of each service behind nginx (users, products, orders, payments)
REPLICAS=2
